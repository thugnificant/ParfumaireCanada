---
import Layout from '../layouts/Layout.astro';import ProductCard from '../components/ProductCard.astro';import {products,notesText} from '../lib/catalog';
---
<Layout title="Search the collection" description="Find Parfumaire diffusers and fragrances by product name or scent note." noindex><div class="wrap content-bottom"><div class="page-intro"><p class="eyebrow">FOLLOW YOUR CURIOSITY</p><h1>What’s in the air?</h1><p>Search a product, a scent or a note you love.</p></div><div class="catalog-toolbar"><label for="site-search" class="sr-only">Search products and scent notes</label><input id="site-search" type="search" autocomplete="off" placeholder="Try cedar, citrus or La Tour…"/></div><p id="search-status" class="result-count" aria-live="polite">{products.length} products to explore</p><div class="product-grid catalog-grid">{products.map(p=><div class="search-result" data-search={`${p.title} ${notesText(p)} ${p.category}`.toLowerCase()}><ProductCard product={p}/></div>)}</div><div id="search-empty" class="empty-state" hidden><h2>No matches just yet.</h2><p>Try a different scent note or explore the complete collection.</p><a class="pill pill-outline" href="/collections/all/">Explore all products →</a></div></div><script>const input=document.querySelector<HTMLInputElement>('#site-search')!;input.addEventListener('input',()=>{let found=0;document.querySelectorAll<HTMLElement>('[data-search]').forEach(c=>{c.hidden=!c.dataset.search!.includes(input.value.trim().toLowerCase());if(!c.hidden)found++;});document.querySelector('#search-status')!.textContent=`${found} ${found===1?'product':'products'} found`;document.querySelector<HTMLElement>('#search-empty')!.hidden=found>0;});</script></Layout>
