---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found"
  description="That page has drifted away. Explore the Parfumaire Canada collection or return home."
  noindex
>
  <div class="wrap empty-state">
    <p class="eyebrow">404 · A LITTLE LOST IN THE AIR</p>
    <h1>Let’s find your way.</h1>
    <p>This page doesn’t exist, but your next favourite scent might.</p>
    <a class="pill pill-dark" href="/collections/all/">
      Explore the collection →
    </a>{' '}
    <a class="pill pill-outline" href="/">
      Back to home
    </a>
  </div>
</Layout>
