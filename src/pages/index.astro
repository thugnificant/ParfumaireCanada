---
import Layout from '../layouts/Layout.astro';
import AtmosphereHero from '../components/AtmosphereHero.astro';
import '../styles/motion.css';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductView from '../components/ProductView.astro';
import EnquiryBanner from '../components/EnquiryBanner.astro';
import { byHandle } from '../lib/catalog';
import reviews from '../data/reviews.json';
const featured = [
  'cozyair-scent-diffuser',
  'la-tour-scent-diffuser',
  'cozyair-max-scent-diffuser',
  '213-rue-st-honore',
].map(byHandle);
const featuredReviews = reviews
  .filter((r) => !r.body.includes('�') && r.body.length > 30)
  .slice(0, 4);
---

<Layout
  title="Make yourself at home"
  description="Discover Parfumaire’s signature fragrances, scent diffusers and business scenting. Explore the collection and find an atmosphere that feels like you."
  image="/images/photography/parfumaire-atmosphere.webp"
>
  <AtmosphereHero />
  <section class="featured wrap section-space" aria-labelledby="featured-heading">
    <div class="section-heading">
      <h2 id="featured-heading">Meet your atmosphere.</h2>
      <p>Thoughtfully designed diffusers. Fragrances with a story.</p>
    </div>
    <div class="product-grid">
      {featured.map((p) => (
        <ProductCard product={p} />
      ))}
    </div>
    <div class="center">
      <a class="pill pill-outline" href="/collections/all/">
        Discover the full collection <Icon />
      </a>
    </div>
  </section>
  <section class="editorial-grid wrap" aria-label="Discover the world of Parfumaire">
    <a class="editorial-large" href="/business-scenting/">
      <img
        src="/images/photography/interior-3000.webp"
        sizes="(max-width:580px) 90vw, 65vw"
        width="3000"
        height="2000"
        alt="A bright contemporary living room with natural wood and plants"
        loading="lazy"
      />
      <div>
        <h2>
          An atmosphere
          <br />
          for every occasion.
        </h2>
        <span class="pill">
          Explore business scenting <Icon />
        </span>
      </div>
    </a>
    <div class="editorial-stack">
      <a class="editorial-small blue" href="/business-scenting/">
        <div>
          <h2>Make an impression.</h2>
          <span class="pill">
            For your business <Icon size={17} />
          </span>
        </div>
        <ProductView
          class="editorial-product"
          handle="cozyair-max-scent-diffuser"
          label="CozyAir Max scent diffuser"
        />
      </a>
      <a class="editorial-small sand" href="/fragrance-finder/">
        <div>
          <h2>Find your signature.</h2>
          <span class="pill">
            Find your scent <Icon size={17} />
          </span>
        </div>
        <img
          src="/images/renders/air-mykonos-cutout.webp"
          width="640"
          height="640"
          alt="Air Mykonos fragrance bottle"
          loading="lazy"
        />
      </a>
    </div>
  </section>
  <p class="photography-credit wrap">
    Interior photography: <a href="https://www.pexels.com/photo/19966784/">Alex Tyson / Pexels</a>
  </p>
  <section class="testimonials wrap section-space" aria-labelledby="testimonials-title">
    <div class="section-heading">
      <h2 id="testimonials-title">A feeling worth sharing.</h2>
      <p>Voices from the original Parfumaire shop.</p>
    </div>
    <div class="quote-grid">
      {featuredReviews.map((r) => (
        <figure>
          <span class="quote-mark" aria-hidden="true">
            “
          </span>
          <blockquote>{r.body}</blockquote>
          <figcaption>
            {r.author || 'Parfumaire customer'}
            <a href={r.sourceUrl}>Original shop review ↗</a>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
  <EnquiryBanner />
</Layout>
