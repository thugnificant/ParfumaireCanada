---
import Layout from '../layouts/Layout.astro';
import { srcset } from '../lib/images';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import EnquiryBanner from '../components/EnquiryBanner.astro';
import { byHandle, priceLabel } from '../lib/catalog';
import media from '../data/media.json';
import reviews from '../data/reviews.json';
const cozy = byHandle('cozyair-scent-diffuser');
const tower = byHandle('la-tour-scent-diffuser');
const featured = [
  'cozyair-scent-diffuser',
  'la-tour-scent-diffuser',
  'cozyair-max-scent-diffuser',
  '213-rue-st-honore',
].map(byHandle);
const featuredReviews = reviews
  .filter((r) => !r.body.includes('�') && r.body.length > 30)
  .slice(0, 4);
---

<Layout
  title="Make yourself at home"
  description="Discover Parfumaire’s signature fragrances, scent diffusers and business scenting. Explore the collection and find an atmosphere that feels like you."
  image={cozy.images[1].path}
>
  <section class="hero" aria-label="Welcome to Parfumaire Canada">
    <div class="hero-main">
      <img
        class="hero-photo"
        src={cozy.images[1].path}
        srcset={srcset(cozy.images[1])}
        sizes="(max-width:580px) 100vw, 72vw"
        width={cozy.images[1].width}
        height={cozy.images[1].height}
        alt="CozyAir diffuser in a thoughtfully styled living space"
        fetchpriority="high"
      />
      <div class="hero-copy">
        <p class="eyebrow">THE ART OF ATMOSPHERE</p>
        <h1>
          A scent.
          <br />A feeling.
          <br />A place to call yours.
        </h1>
        <a class="pill" href="/collections/all/">
          Explore the collection <Icon />
        </a>
      </div>
      <div class="hero-word" aria-hidden="true">
        parfumaire
      </div>
      <span class="hero-caption">GOOD THINGS ARE IN THE AIR.</span>
    </div>
    <aside class="hero-feature">
      <div>
        <span class="tag">MEET LA TOUR</span>
        <h2>
          Small footprint.
          <br />
          Lasting impression.
        </h2>
      </div>
      <a
        class="hero-product"
        href="/products/la-tour-scent-diffuser/"
        aria-label="Discover La Tour scent diffuser"
      >
        <img
          src={tower.images[0].path}
          width={tower.images[0].width}
          height={tower.images[0].height}
          alt="La Tour black freestanding scent diffuser"
          fetchpriority="high"
        />
      </a>
      <div class="feature-bottom">
        <div>
          <p>La Tour Scent Diffuser</p>
          <span>{priceLabel(tower)} · reference</span>
        </div>
        <a class="pill" href="/products/la-tour-scent-diffuser/">
          Discover La Tour <Icon />
        </a>
      </div>
    </aside>
  </section>
  <section class="lifestyle wrap">
    <img
      src={media.lifestyle.path}
      srcset={srcset(media.lifestyle)}
      sizes="90vw"
      width={media.lifestyle.width}
      height={media.lifestyle.height}
      alt={media.lifestyle.alt}
      loading="lazy"
    />
    <div class="lifestyle-copy">
      <p class="eyebrow">MAKE ROOM FOR A FEELING</p>
      <h2>
        Home is more
        <br />
        than a place.
      </h2>
      <p>
        It’s the welcome. The familiar. The little things.
        <br />
        Find a fragrance that makes it yours.
      </p>
      <a class="pill" href="/collections/scents/">
        Explore scents <Icon />
      </a>
    </div>
  </section>
  <section class="featured wrap section-space" aria-labelledby="featured-heading">
    <div class="section-heading">
      <p class="eyebrow">A LITTLE EVERYDAY EXTRAORDINARY</p>
      <h2 id="featured-heading">Meet your atmosphere.</h2>
      <p>Thoughtfully designed diffusers. Fragrances with a story.</p>
    </div>
    <div class="product-grid">
      {featured.map((p) => (
        <ProductCard product={p} />
      ))}
    </div>
    <div class="center">
      <a class="pill pill-outline" href="/collections/all/">
        Discover the full collection <Icon />
      </a>
    </div>
  </section>
  <section class="editorial-grid wrap" aria-label="Discover the world of Parfumaire">
    <a class="editorial-large" href="/about/">
      <img
        src={media.story.path}
        srcset={srcset(media.story)}
        sizes="(max-width:580px) 90vw, 65vw"
        width={media.story.width}
        height={media.story.height}
        alt={media.story.alt}
        loading="lazy"
      />
      <div>
        <p class="eyebrow">A FRENCH SENSIBILITY</p>
        <h2>
          Every fragrance
          <br />
          tells a story.
        </h2>
        <span class="pill">
          This is ours <Icon />
        </span>
      </div>
    </a>
    <div class="editorial-stack">
      <a class="editorial-small blue" href="/business-scenting/">
        <div>
          <p class="eyebrow">A WELCOME THEY’LL REMEMBER</p>
          <h2>Make an impression.</h2>
          <span class="pill">
            For your business <Icon size={17} />
          </span>
        </div>
        <img
          src={byHandle('cozyair-max-scent-diffuser').images[0].small}
          width="640"
          height="640"
          alt="CozyAir Max scent diffuser"
          loading="lazy"
        />
      </a>
      <a class="editorial-small sand" href="/fragrance-finder/">
        <div>
          <p class="eyebrow">FOLLOW YOUR SENSES</p>
          <h2>Find your signature.</h2>
          <span class="pill">
            Find your scent <Icon size={17} />
          </span>
        </div>
        <img
          src={byHandle('air-mykonos').images[2].small}
          width="640"
          height="640"
          alt="Air Mykonos fragrance bottle"
          loading="lazy"
        />
      </a>
    </div>
  </section>
  <section class="testimonials wrap section-space" aria-labelledby="testimonials-title">
    <div class="section-heading">
      <p class="eyebrow">FROM THE PARFUMAIRE COMMUNITY</p>
      <h2 id="testimonials-title">A feeling worth sharing.</h2>
      <p>Voices from the original Parfumaire shop.</p>
    </div>
    <div class="quote-grid">
      {featuredReviews.map((r) => (
        <figure>
          <span class="quote-mark" aria-hidden="true">
            “
          </span>
          <blockquote>{r.body}</blockquote>
          <figcaption>
            {r.author || 'Parfumaire customer'}
            <a href={r.sourceUrl}>Original shop review ↗</a>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
  <EnquiryBanner />
</Layout>
