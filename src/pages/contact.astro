---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site.mjs';
import { products } from '../lib/catalog';
const quoteProducts = products.map((p) => ({
  handle: p.handle,
  title: p.title,
  image: p.images[0].small,
  variants: p.variants.map((v) => ({ id: v.id, title: v.title, sku: v.sku })),
}));
---

<Layout
  title="Let’s talk scent"
  description="Ask about a diffuser, explore a fragrance or discuss scenting for your business. Preview the Parfumaire Canada enquiry experience."
>
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <span>Contact</span>
    </nav>
    <div class="form-layout">
      <div class="quote-intro">
        <p class="eyebrow">A CONVERSATION STARTS HERE</p>
        <h1>
          Let’s talk
          <br />
          scent.
        </h1>
        <p class="quote-description">
          A fragrance for your home. An atmosphere for your business. A signature that’s entirely
          yours.
        </p>
        <p class="muted">Tell us a little about what you have in mind.</p>
        <div id="enquiry-context" class="quote-selection" hidden>
          <img id="quote-product-image" alt="" width="80" height="100" />
          <div>
            <span class="eyebrow">YOUR SELECTION</span>
            <strong id="quote-product-name"></strong>
            <p id="quote-product-option"></p>
            <a id="quote-product-link" class="text-link">
              Change selection <Icon size={15} />
            </a>
          </div>
        </div>
        <div class="preview-notice">
          <strong>Client preview</strong>
          <br />
          This form previews your enquiry. No message is sent and your details are not stored.
        </div>
        {site.email && (
          <p>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        )}
        {site.phoneE164 && (
          <p>
            <a href={`tel:${site.phoneE164}`}>{site.phoneDisplay}</a>
          </p>
        )}
        <p class="privacy-small">
          Prefer to browse a little more?
          <br />
          <a href="/fragrance-finder/" class="text-link">
            Find your signature scent <Icon size={15} />
          </a>
        </p>
      </div>
      <form
        class="enquiry-form"
        method="post"
        data-config={JSON.stringify({ enquiry: site.enquiry, recipient: site.quoteRecipient })}
        data-products={JSON.stringify(quoteProducts)}
      >
        <ol class="quote-steps" aria-label="Enquiry progress">
          <li aria-current="step">
            <span>1</span> Your details
          </li>
          <li>
            <span>2</span> Review
          </li>
        </ol>
        <div id="quote-fields">
          <h2>A little about you.</h2>
          <p class="form-caption">We’ll keep your product selection with your enquiry.</p>
          <div class="form-row">
            <label for="name">
              Name <span aria-hidden="true">*</span>
              <input id="name" name="name" required autocomplete="name" maxlength="100" />
            </label>
            <label for="email">
              Email <span aria-hidden="true">*</span>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                maxlength="254"
              />
            </label>
          </div>
          <label for="phone">
            Phone <span class="muted">(optional)</span>
            <input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40" />
          </label>
          <label for="interest">
            I’m interested in
            <select id="interest" name="interest">
              <option value="home">Scenting my home</option>
              <option value="product">A particular product</option>
              <option value="business">Scenting my business</option>
              <option value="custom">A custom fragrance</option>
            </select>
          </label>
          <label id="business-field" hidden for="business">
            Business or space <span class="muted">(optional)</span>
            <input
              id="business"
              name="business"
              placeholder="E.g. boutique, hotel lobby, office"
              maxlength="200"
              disabled
            />
          </label>
          <label for="message">
            Your message <span aria-hidden="true">*</span>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              minlength="5"
              maxlength="4000"
              placeholder="What would you like to know?"
            />
          </label>
          <button class="pill pill-dark" type="submit" id="enquiry-submit" disabled>
            Continue to review <Icon />
          </button>
        </div>
        <div id="quote-review" hidden>
          <h2 tabindex="-1" id="review-heading">
            Everything look right?
          </h2>
          <p class="form-caption">Check your details before finishing the preview.</p>
          <dl class="review-details" id="review-details"></dl>
          <div class="preview-notice">
            This preview won’t send an enquiry or retain your personal details.
          </div>
          <button type="button" class="pill pill-dark" id="enquiry-confirm">
            Preview enquiry <Icon />
          </button>
          <button type="button" class="pill pill-outline" id="enquiry-edit">
            Edit details
          </button>
        </div>
        <div id="quote-complete" hidden>
          <span class="complete-mark" aria-hidden="true">
            ✓
          </span>
          <h2>Preview complete.</h2>
          <p>No enquiry has been sent.</p>
          <a class="pill pill-outline" href="/collections/all/">
            Keep exploring <Icon />
          </a>
        </div>
        <noscript>
          <p class="preview-notice">
            Enable JavaScript to preview this enquiry. No details can be submitted here.
          </p>
        </noscript>
        <div
          class="form-status"
          role="status"
          aria-live="polite"
          tabindex="-1"
          id="form-status"
        ></div>
        <button type="button" class="pill pill-outline" id="copy-enquiry" hidden>
          Copy enquiry details
        </button>
        <p class="privacy-small">
          * Required. A quote request is not an order or a price agreement. Read our{' '}
          <a href="/privacy/">privacy information</a>.
        </p>
      </form>
    </div>
  </div>
  <script src="../scripts/enquiry-form.ts"></script>
</Layout>
