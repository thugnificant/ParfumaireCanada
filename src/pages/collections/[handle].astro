---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import EnquiryBanner from '../../components/EnquiryBanner.astro';
import {products,family,notesText} from '../../lib/catalog';
export function getStaticPaths(){return ['all','scent-diffusers','scents','candles','shop'].map(handle=>({params:{handle}}));}
const {handle}=Astro.params;const isScents=handle==='scents';const isDiffusers=handle==='scent-diffusers';const candles=handle==='candles';
const title=isScents?'A scent for every feeling.':isDiffusers?'Good things are in the air.':candles?'A little glow. Coming later.':'Make room for atmosphere.';
const description=isScents?'Explore 18 signature fragrances, their scent notes and compatible bottle sizes. Find your fragrance and request a Canadian quote.':isDiffusers?'Compare La Tour, CozyAir and CozyAir Max scent diffusers. Explore sizes, capacities and source reference prices.':'Discover the full Parfumaire collection of scent diffusers and signature fragrances for your home or business.';
const list=candles?[]:products.filter(p=>isScents?p.category==='scents':isDiffusers?p.category==='diffusers':true).sort((a,b)=>a.category.localeCompare(b.category));
---
<Layout title={isScents?'Signature fragrances':isDiffusers?'Scent diffusers':candles?'Candles':'Explore the collection'} description={description}>
<div class="wrap content-bottom"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>{isScents?'Scents':isDiffusers?'Diffusers':candles?'Candles':'Collection'}</span></nav><div class="page-intro"><p class="eyebrow">THE PARFUMAIRE COLLECTION</p><h1>{title}</h1><p>{isScents?'Fresh, floral, warm or woody. Find a fragrance that feels like you.':isDiffusers?'Considered design. A memorable atmosphere. Find the diffuser that fits your space.':candles?'There are no candles in the current source collection. Explore our signature fragrances in the meantime.':'A home that welcomes you. A space they remember. Explore our diffusers and signature fragrances.'}</p></div>
<nav class="collection-tabs" aria-label="Collections"><a href="/collections/all/" aria-current={['all','shop'].includes(handle!)?'page':undefined}>Explore all</a><a href="/collections/scent-diffusers/" aria-current={isDiffusers?'page':undefined}>Scent diffusers</a><a href="/collections/scents/" aria-current={isScents?'page':undefined}>Signature scents</a></nav>
{!candles&&<><div class="catalog-toolbar"><label class="sr-only" for="catalog-search">Search this collection</label><input id="catalog-search" type="search" placeholder="Search by name or scent note…" autocomplete="off"/><label for="family-filter">Scent family</label><select id="family-filter"><option value="">All families</option>{['Citrus & fresh','Floral & soft','Warm & spicy','Woody & musky'].map(x=><option>{x}</option>)}</select><label for="sort">Sort</label><select id="sort"><option value="featured">Featured</option><option value="az">Name: A–Z</option><option value="low">Price: low to high</option><option value="high">Price: high to low</option></select></div><p class="result-count" aria-live="polite" id="result-count">{list.length} products</p><div class="product-grid catalog-grid" id="catalog-grid">{list.map(p=><div class="catalog-item" data-name={`${p.title} ${notesText(p)}`.toLowerCase()} data-title={p.title} data-family={p.category==='scents'?family(p):''} data-price={Math.min(...p.variants.map(v=>v.priceMinor))}><ProductCard product={p}/></div>)}</div><div class="no-results" hidden><h2>No scents found.</h2><p>Try another name, note or fragrance family.</p><button class="pill pill-outline" id="clear-filters">Clear filters</button></div><p class="pricing-note">Prices shown are original USD reference prices. Canadian prices, availability and terms will be confirmed with your quote. Fragrance-family filters are browsing suggestions based on the source’s listed notes.</p></>}
{isDiffusers&&<section class="comparison"><h2>Find your fit.</h2><table><caption>Specifications from the original product catalog. Confirm installation and space requirements with your enquiry.</caption><thead><tr><th scope="col">At a glance</th><th scope="col">La Tour</th><th scope="col">CozyAir</th><th scope="col">CozyAir Max</th></tr></thead><tbody><tr><th scope="row">Capacity</th><td>120 ml</td><td>500 ml</td><td>1 L</td></tr><tr><th scope="row">Source dimensions</th><td>4⅜″ × 47¼″</td><td>6⅜″ × 3¾″ × 9¾″</td><td>15⅛″ × 9″ × 18⅜″</td></tr><tr><th scope="row">Colour options</th><td>Black</td><td>White, Black</td><td>White, Black</td></tr><tr><th scope="row">Explore</th><td><a class="text-link" href="/products/la-tour-scent-diffuser/">Meet La Tour →</a></td><td><a href="/products/cozyair-scent-diffuser/">Meet CozyAir →</a></td><td><a href="/products/cozyair-max-scent-diffuser/">Meet CozyAir Max →</a></td></tr></tbody></table></section>}
</div><EnquiryBanner/>
<script>const search=document.querySelector<HTMLInputElement>('#catalog-search');const family=document.querySelector<HTMLSelectElement>('#family-filter');const sort=document.querySelector<HTMLSelectElement>('#sort');const grid=document.querySelector('#catalog-grid');const cards=[...document.querySelectorAll<HTMLElement>('.catalog-item')];function filter(){let visible=0;for(const c of cards){c.hidden=!(c.dataset.name?.includes(search?.value.trim().toLowerCase()||'')&&(!family?.value||c.dataset.family===family.value));if(!c.hidden)visible++;}const count=document.querySelector('#result-count');if(count)count.textContent=`${visible} ${visible===1?'product':'products'}`;const empty=document.querySelector<HTMLElement>('.no-results');if(empty)empty.hidden=visible>0;const sorted=[...cards];if(sort?.value==='az')sorted.sort((a,b)=>a.dataset.title!.localeCompare(b.dataset.title!));if(sort?.value==='low')sorted.sort((a,b)=>Number(a.dataset.price)-Number(b.dataset.price));if(sort?.value==='high')sorted.sort((a,b)=>Number(b.dataset.price)-Number(a.dataset.price));sorted.forEach(c=>grid?.append(c));}search?.addEventListener('input',filter);family?.addEventListener('change',filter);sort?.addEventListener('change',filter);document.querySelector('#clear-filters')?.addEventListener('click',()=>{if(search)search.value='';if(family)family.value='';filter();search?.focus();});</script>
</Layout>
