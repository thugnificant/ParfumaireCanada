---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProductHotspot from '../components/ProductHotspot.astro';
import EnquiryBanner from '../components/EnquiryBanner.astro';
import pages from '../data/pages.json';
import aliases from '../data/aliases.json';
import media from '../data/media.json';
import lifestyle from '../data/lifestyle.json';
export function getStaticPaths() {
  return [
    ...pages.map((page) => ({ params: { path: page.slug }, props: { page, alias: null } })),
    ...aliases.map((alias) => ({ params: { path: alias.slug }, props: { page: null, alias } })),
  ];
}
const { page, alias } = Astro.props;
const composition = page?.image ? lifestyle[page.image as keyof typeof lifestyle] : null;
const photo = composition || (page?.image ? media[page.image as keyof typeof media] : null);
const services = pages.filter((x) =>
  ['scent-branding', 'odor-elimination', 'custom-fragrances'].includes(x.slug),
);
---

{alias ? (
  <Layout
    title={alias.title}
    description="Explore this content in the Parfumaire Canada catalog."
    noindex
    canonicalPath={alias.target}
  >
    <div class="info-page">
      <p class="eyebrow">PARFUMAIRE CANADA</p>
      <h1>A new place to explore.</h1>
      <p class="lead">You can find this content in our Canadian collection.</p>
      <a class="pill pill-dark" href={alias.target}>
        Continue to {alias.target.includes('products/') ? 'the product' : 'the page'} <Icon />
      </a>
    </div>
  </Layout>
) : (
  page && (
    <Layout
      title={page.title.replace(/\.$/, '')}
      description={page.description}
      image={photo?.path}
    >
      <div class="wrap content-bottom">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <span>{page.eyebrow}</span>
        </nav>
        {photo ? (
          <>
            <section class="service-hero">
              <div>
                <h1>{page.title}</h1>
                <p>{page.intro}</p>
                <a class="pill pill-dark" href={page.href}>
                  {page.cta}
                  <Icon />
                </a>
              </div>
              <figure
                class="service-photo"
                data-photo-hotspots
                data-image-width={photo.width}
                data-image-height={photo.height}
                data-anchor-x={composition?.hotspotX}
                data-anchor-y={composition?.hotspotY}
              >
                <img
                  src={photo.path}
                  srcset={
                    composition
                      ? `${composition.small} 1280w, ${composition.path} 2528w`
                      : undefined
                  }
                  sizes="(max-width: 900px) 94vw, 52vw"
                  style={composition ? `object-position: ${composition.position}` : undefined}
                  width={photo.width}
                  height={photo.height}
                  alt={photo.alt}
                  fetchpriority="high"
                />
                {composition && (
                  <ProductHotspot
                    id={`service-product-${page.slug}`}
                    name={composition.name}
                    handle={composition.handle}
                  />
                )}
              </figure>
            </section>
            {composition && (
              <p class="service-photo-credit">
                Interior visual: Higgsfield · Parfumaire product render
              </p>
            )}
            <div class="service-body prose" set:html={page.body} />
            {page.slug === 'business-scenting' && (
              <div class="service-links">
                {services.map((s) => (
                  <a href={`/${s.slug}/`}>
                    <h3>{s.eyebrow.toLowerCase()}</h3>
                    <p>{s.intro}</p>
                    <span class="text-link">
                      Discover more <Icon size={17} />
                    </span>
                  </a>
                ))}
              </div>
            )}
          </>
        ) : (
          <article class="info-page">
            <p class="eyebrow">{page.eyebrow}</p>
            <h1>{page.title}</h1>
            <div class="prose" set:html={page.body} />
          </article>
        )}
      </div>
      {photo && <EnquiryBanner />}
    </Layout>
  )
)}

<script src="../scripts/photo-hotspots.ts"></script>
