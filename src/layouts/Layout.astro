---
import '../styles/global.css';
import '../styles/accessibility.css';
import '../styles/motion.css';
import Icon from '../components/Icon.astro';
import { site } from '../data/site.mjs';
interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: Record<string, unknown>;
  noindex?: boolean;
  canonicalPath?: string;
}
const {
  title,
  description,
  image = '/images/social-card.webp',
  schema,
  noindex = false,
  canonicalPath,
} = Astro.props;
const origin = site.environment === 'production' ? site.productionUrl! : site.demoUrl;
const canonical = new URL(canonicalPath || Astro.url.pathname, origin).href;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: origin,
};
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ebeadf" />
    <title>{title} | Parfumaire Canada</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={site.indexing && !noindex ? 'index,follow' : 'noindex,follow'} />
    <meta property="og:title" content={`${title} | Parfumaire Canada`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, origin).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=supreme@400,500,700&display=swap"
      rel="stylesheet"
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organization).replace(/</g, '\u003c')}
    />
    {schema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema).replace(/</g, '\u003c')}
      />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/">
          parfumaire<span>CANADA</span>
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          <button
            class="explore-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="explore-menu"
          >
            Explore <Icon name="down" size={13} />
          </button>
          <a href="/collections/scent-diffusers/">Diffusers</a>
          <a href="/collections/scents/">Scents</a>
          <a href="/business-scenting/">For business</a>
          <a href="/about/">Our story</a>
          <a href="/fragrance-finder/">Find your scent</a>
        </nav>
        <div class="header-actions">
          <a href="/search/" class="icon-button" aria-label="Search catalog">
            <Icon name="search" />
          </a>
          <button
            class="icon-button menu-toggle"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-nav"
          >
            <Icon name="menu" />
          </button>
        </div>
        <nav id="explore-menu" class="explore-menu" aria-label="Explore collections" hidden>
          <a href="/collections/all/">
            <Icon name="collection" size={34} />
            <span>Explore all</span>
          </a>
          <a href="/collections/scent-diffusers/">
            <Icon name="diffuser" size={34} />
            <span>Scent diffusers</span>
          </a>
          <a href="/collections/scents/">
            <Icon name="fragrance" size={34} />
            <span>Signature scents</span>
          </a>
          <a href="/fragrance-finder/">
            <Icon name="home" size={34} />
            <span>For your home</span>
          </a>
          <a href="/business-scenting/">
            <Icon name="business" size={34} />
            <span>For business</span>
          </a>
        </nav>
        <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>
          <a href="/collections/all/">Explore all</a>
          <a href="/collections/scent-diffusers/">Scent diffusers</a>
          <a href="/collections/scents/">Signature scents</a>
          <a href="/business-scenting/">For business</a>
          <a href="/about/">Our story</a>
          <a href="/fragrance-finder/">Find your scent</a>
          <a href="/contact/">Get in touch</a>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer wrap">
        <div class="footer-main">
          <div class="footer-brand">
            <a class="wordmark" href="/">
              parfumaire<span>CANADA</span>
            </a>
            <p>The art of a memorable atmosphere.</p>
          </div>
          <div>
            <h2>Explore</h2>
            <a href="/collections/all/">All products</a>
            <a href="/collections/scent-diffusers/">Scent diffusers</a>
            <a href="/collections/scents/">Signature scents</a>
            <a href="/fragrance-finder/">Find your scent</a>
          </div>
          <div>
            <h2>For business</h2>
            <a href="/business-scenting/">Business scenting</a>
            <a href="/scent-branding/">Scent branding</a>
            <a href="/odor-elimination/">Odour management</a>
            <a href="/custom-fragrances/">Custom fragrances</a>
          </div>
          <div>
            <h2>Parfumaire</h2>
            <a href="/about/">Our story</a>
            <a href="/journal/">Scent journal</a>
            <a href="/faq/">Questions & care</a>
            <a href="/contact/">Contact us</a>
          </div>
          <div>
            <h2>Let’s talk scent</h2>
            <p>
              For your home.
              <br />
              For your business.
              <br />
              For a feeling.
            </p>
            <a class="text-link" href="/contact/">
              Get in touch <Icon size={15} />
            </a>
          </div>
        </div>
        <div class="footer-bottom">
          <p>
            © {new Date().getFullYear()} Parfumaire Canada{' '}
            <span class="demo-label">Client preview</span>
          </p>
          <div>
            <a href="/privacy/">Privacy</a>
            <a href="/terms/">Demo terms</a>
            <a href="/site-map/">Site map</a>
          </div>
        </div>
        <p class="demo-note">
          Client review demo. Prices are USD references; Canadian pricing and contact details are
          pending. Enquiries are previews and are not sent.
        </p>
      </footer>
    </div>
    <script src="../scripts/navigation.ts"></script>
    <script src="../scripts/smooth-scroll.ts"></script>
  </body>
</html>
