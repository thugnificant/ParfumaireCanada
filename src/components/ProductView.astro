---
interface Props {
  handle: string;
  label: string;
  hero?: boolean;
  finish?: 'white' | 'black';
  grounded?: boolean;
  class?: string;
}
const {
  handle,
  label,
  finish,
  hero = false,
  grounded = false,
  class: className = '',
} = Astro.props;
---

<div
  class:list={['product-view', className]}
  data-product-view={handle}
  data-finish={finish}
  data-hero-product={hero || undefined}
  data-grounded={grounded || undefined}
>
  <img
    class="product-fallback"
    src={`/images/models/${handle}${finish === 'white' && handle.includes('max') ? '-white' : ''}-studio.webp`}
    width="1200"
    height="1600"
    alt={label}
    loading={hero ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={hero ? 'high' : 'auto'}
  />
  <canvas aria-hidden="true"></canvas>
</div>
<script src="../scripts/product-view.ts"></script>
