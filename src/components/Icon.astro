---
interface Props {
  name?: string;
  size?: number;
}
const { name = 'arrow', size = 20 } = Astro.props;
const paths: Record<string, string> = {
  arrow: 'M4 12h16m-6-6 6 6-6 6',
  search: 'm21 21-5-5M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0',
  close: 'm6 6 12 12M6 18 18 6',
  menu: 'M4 7h16M4 12h16M4 17h16',
  down: 'm6 9 6 6 6-6',
  plus: 'M12 5v14M5 12h14',
  collection: 'M3 9h18v12H3V9Zm-1 0 3-6h14l3 6M9 9v12M15 9v12M8 3 7 9M16 3l1 6',
  diffuser:
    'M6 6h12v15H6V6Zm8 0V3h2v3M8 10h3v2H8v-2M8 14h.1M10 14h.1M15 10v8M13 12h4M13 16h4M9 3c-1-1 1-1 0-2',
  fragrance: 'M8 7h8l2 3v11H6V10l2-3Zm1 0V3h6v4M6 12h12M9 15h6M10 18h4',
  home: 'm2 11 10-9 10 9M5 9v12h14V9M9 21v-7h6v7',
