    'M4 21V5h10v16M14 10h6v11M2 21h20M7 8h1M10 8h1M7 11h1M10 11h1M7 14h1M10 14h1M8 21v-4h3v4M17 13h.1M17 16h.1',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name] || paths.arrow} />
</svg>
