---
import Icon from './Icon.astro';
import ProductView from './ProductView.astro';
import { byHandle, priceLabel } from '../lib/catalog';
const tower = byHandle('la-tour-scent-diffuser');
---

<div class="atmosphere-story" data-atmosphere>
  <section class="atmosphere-layout" aria-label="Good things are in the air">
    <div class="hero-main atmosphere-main">
      <img
        class="sky-room"
        src="/images/photography/clouds-3200.webp"
        srcset="/images/photography/clouds-1600.webp 1600w, /images/photography/clouds-3200.webp 3200w"
        sizes="(max-width:700px) 100vw, 72vw"
        width="3200"
        height="2133"
        alt=""
        fetchpriority="high"
      />
      <div class="atmosphere-shade" aria-hidden="true"></div>
      <div class="atmosphere-copy">
        <h1>
          Good things
          <br />
          are in the air.
        </h1>
        <a class="pill" href="/collections/scent-diffusers/">
          Find your diffuser <Icon />
        </a>
      </div>
      <div class="atmosphere-word" aria-hidden="true">
        parfumaire
      </div>
      <div class="atmosphere-bottom">
        <span class="atmosphere-hint">
          Scroll into a new atmosphere. <Icon name="arrow" />
        </span>
        <a
          href="/products/cozyair-max-scent-diffuser/?variant=41466755514554"
          class="atmosphere-product-link"
        >
          Meet CozyAir Max <Icon />
        </a>
      </div>
      <span class="flight-origin" aria-hidden="true"></span>
    </div>
    <aside class="atmosphere-feature">
      <h2>
        Small footprint.
        <br />
        Lasting impression.
      </h2>
      <a
        class="atmosphere-feature-product"
        href="/products/la-tour-scent-diffuser/"
        aria-label="Discover La Tour scent diffuser"
      >
        <ProductView
          handle="la-tour-scent-diffuser"
          label="La Tour black freestanding scent diffuser"
          hero
        />
      </a>
      <div class="feature-bottom">
        <div>
          <p>La Tour Scent Diffuser</p>
          <span>{priceLabel(tower)} · reference</span>
        </div>
        <a class="pill" href="/products/la-tour-scent-diffuser/">
          Discover La Tour <Icon />
        </a>
      </div>
    </aside>
  </section>
  <section class="atmosphere-landing" aria-labelledby="landing-heading">
    <img
      class="landing-photo"
      src="/images/photography/floor-3200.webp"
      srcset="/images/photography/floor-1600.webp 1600w, /images/photography/floor-3200.webp 3200w"
      sizes="(max-width:700px) 180vw, 100vw"
      width="3200"
      height="2136"
      alt="A blue sofa in a sunlit room with a wooden floor and woven rug"
      decoding="async"
    />
    <div class="landing-copy">
      <h2 id="landing-heading">Big atmosphere. Small footprint.</h2>
      <p>
        Meet CozyAir Max. Floor-standing fragrance,
        <br />
        made to feel right at home.
      </p>
      <a class="pill" href="/products/cozyair-max-scent-diffuser/?variant=41466755514554">
        Discover CozyAir Max <Icon />
      </a>
    </div>
    <span class="flight-destination" aria-hidden="true"></span>
    <div class="landing-shadow" aria-hidden="true"></div>
    <ProductView
      class="landing-fallback"
      handle="cozyair-max-scent-diffuser"
      label="White CozyAir Max floor-standing scent diffuser"
      finish="white"
      grounded
    />
  </section>
  <ProductView
    handle="cozyair-max-scent-diffuser"
    label="White Parfumaire CozyAir Max floor diffuser with animated airflow"
    finish="white"
    hero
    class="atmosphere-product"
  />
</div>
<div class="photography-credit">
  <span>
    Photography: <a href="https://www.pexels.com/photo/4610805/">Brett Sayles</a> &amp;{' '}
    <a href="https://www.pexels.com/photo/7556566/">Kampus Production</a> / Pexels
  </span>
  <button type="button" class="motion-toggle" aria-pressed="false">
    Pause motion
  </button>
</div>
<script src="../scripts/atmosphere.ts"></script>
