---
import Icon from './Icon.astro';
import ProductView from './ProductView.astro';
import { byHandle, priceLabel } from '../lib/catalog';
const tower = byHandle('la-tour-scent-diffuser');
---

<div class="atmosphere-story" data-atmosphere>
  <section class="atmosphere-layout" aria-label="Good things are in the air">
    <div class="hero-main atmosphere-main">
      <img
        class="sky-room"
        src="/images/photography/sky-3000.webp"
        srcset="/images/photography/sky-1600.webp 1600w, /images/photography/sky-3000.webp 2974w"
        sizes="(max-width:700px) 100vw, 72vw"
        width="2974"
        height="4461"
        alt=""
        fetchpriority="high"
      />
      <div class="atmosphere-shade" aria-hidden="true"></div>
      <div class="atmosphere-copy">
        <h1>
          Good things
          <br />
          are in the air.
        </h1>
        <p>A little fragrance. A whole new feeling.</p>
        <a class="pill" href="/collections/scent-diffusers/">
          Find your diffuser <Icon />
        </a>
      </div>
      <div class="atmosphere-word" aria-hidden="true">
        parfumaire
      </div>
      <div class="atmosphere-bottom">
        <span class="atmosphere-hint">
          A little atmosphere, wherever you are. <Icon name="arrow" />
        </span>
        <a href="/products/cozyair-scent-diffuser/" class="atmosphere-product-link">
          Meet CozyAir <Icon />
        </a>
      </div>
      <span class="flight-origin" aria-hidden="true"></span>
    </div>
    <aside class="atmosphere-feature">
      <h2>
        Small footprint.
        <br />
        Lasting impression.
      </h2>
      <a
        class="atmosphere-feature-product"
        href="/products/la-tour-scent-diffuser/"
        aria-label="Discover La Tour scent diffuser"
      >
        <ProductView
          handle="la-tour-scent-diffuser"
          label="La Tour black freestanding scent diffuser"
          hero
        />
      </a>
      <div class="feature-bottom">
        <div>
          <p>La Tour Scent Diffuser</p>
          <span>{priceLabel(tower)} · reference</span>
        </div>
        <a class="pill" href="/products/la-tour-scent-diffuser/">
          Discover La Tour <Icon />
        </a>
      </div>
    </aside>
  </section>
  <section class="atmosphere-landing" aria-labelledby="landing-heading">
    <img
      class="landing-photo"
      src="/images/photography/workspace-3000.webp"
      srcset="/images/photography/workspace-1600.webp 1600w, /images/photography/workspace-3000.webp 3000w"
      sizes="(max-width:700px) 180vw, 100vw"
      width="3000"
      height="2000"
      alt="Sunlit workspace with a wooden desk, plants and a laptop"
      decoding="async"
    />
    <div class="landing-copy">
      <h2 id="landing-heading">
        Make room
        <br />
        for a feeling.
      </h2>
      <p>
        Your everyday space.
        <br />A whole new atmosphere.
      </p>
      <a class="pill" href="/products/cozyair-scent-diffuser/">
        Discover CozyAir <Icon />
      </a>
    </div>
    <span class="flight-destination" aria-hidden="true"></span>
    <div class="landing-shadow" aria-hidden="true"></div>
    <ProductView
      class="landing-fallback"
      handle="cozyair-scent-diffuser"
      label="CozyAir white scent diffuser on the desk"
      grounded
    />
  </section>
  <ProductView
    handle="cozyair-scent-diffuser"
    label="White Parfumaire CozyAir diffuser with animated airflow"
    hero
    class="atmosphere-product"
  />
</div>
<div class="photography-credit">
  <span>
    Photography: <a href="https://unsplash.com/photos/Ir1-0Dvpn8A">ITT CU</a> &amp;{' '}
    <a href="https://unsplash.com/photos/IisDPFNUS4k">Minh Pham</a> / Unsplash
  </span>
  <button type="button" class="motion-toggle" aria-pressed="false">
    Pause motion
  </button>
</div>
<script src="../scripts/atmosphere.ts"></script>
