---
import { priceLabel, productPath, type Product } from '../lib/catalog';
import Icon from './Icon.astro';
import ProductView from './ProductView.astro';
interface Props {
  product: Product;
}
const { product: p } = Astro.props;
---

<article
  class="product-card"
  data-product-card
  data-name={p.title.toLowerCase()}
  data-category={p.category}
  data-price={Math.min(...p.variants.map((v) => v.priceMinor))}
>
  <a
    class:list={['product-stage', { tower: p.handle.startsWith('la-tour') }]}
    href={productPath(p)}
    aria-label={`Explore ${p.title}`}
  >
    <ProductView handle={p.handle} label={p.title} />
    <span class="product-arrow">
      <Icon />
    </span>
  </a>
  <div class="product-meta">
    <h3>
      <a href={productPath(p)}>{p.title}</a>
    </h3>
    <p class="product-price">
      {priceLabel(p)} <span>reference price</span>
    </p>
  </div>
</article>
