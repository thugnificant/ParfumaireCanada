---
import { priceLabel, productPath, type Product } from '../lib/catalog';
import Icon from './Icon.astro';
import { srcset } from '../lib/images';
interface Props {
  product: Product;
}
const { product: p } = Astro.props;
const img = p.images[0];
---

<article
  class="product-card"
  data-product-card
  data-name={p.title.toLowerCase()}
  data-category={p.category}
  data-price={Math.min(...p.variants.map((v) => v.priceMinor))}
>
  <a
    class:list={['product-stage', { tower: p.handle.startsWith('la-tour') }]}
    href={productPath(p)}
    aria-label={`Explore ${p.title}`}
  >
    <img
      src={img.small}
      srcset={srcset(img)}
      sizes="(max-width:850px) 45vw, 22vw"
      width={img.width}
      height={img.height}
      alt={p.title}
      loading="lazy"
      decoding="async"
    />
    <span class="product-arrow">
      <Icon />
    </span>
  </a>
  <div class="product-meta">
    <p class="eyebrow">{p.category === 'diffusers' ? 'Scent diffuser' : 'Signature fragrance'}</p>
    <h3>
      <a href={productPath(p)}>{p.title}</a>
    </h3>
    <p class="product-price">
      {priceLabel(p)} <span>reference price</span>
    </p>
  </div>
</article>
